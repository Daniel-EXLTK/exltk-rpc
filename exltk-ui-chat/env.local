# Configuración A2A para comunicación con r0d0 agent
# Protocolo A2A puro según documentación oficial

# A2A Agent Connection (r0d0 A2A Server)
NEXT_PUBLIC_A2A_AGENT_URL=http://localhost:8501
NEXT_PUBLIC_TARGET_AGENT=r0d0_agent

# Configuración de desarrollo
NODE_ENV=development
NEXT_PUBLIC_ENVIRONMENT=local

# Configuración de API A2A
NEXT_PUBLIC_API_TIMEOUT=30000
NEXT_PUBLIC_ENABLE_DEBUG=true

# Configuración de UI
NEXT_PUBLIC_THEME=dark
NEXT_PUBLIC_ENABLE_ANIMATIONS=true

# Legacy ADK variables (deprecated)
